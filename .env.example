# Copy this file to .env and fill in WANDB_API_KEY. Never commit .env.

# Your W&B API key, from https://wandb.ai/authorize (User settings, API keys).
WANDB_API_KEY=

# Passcode your phone enters to unlock the app. Leave empty and watchBoard generates
# one on first start, prints it, and saves it in .app-secrets.json.
APP_PASSCODE=

# Port and bind address. 0.0.0.0 lets phones on your Wi-Fi reach this computer.
PORT=8787
HOST=0.0.0.0

# Set to 0 to hide the "Stop run" and sweep pause, resume and stop buttons.
ALLOW_ACTIONS=1

# Only change these for W&B Dedicated Cloud or a self-managed server.
# WANDB_BASE_URL=https://api.wandb.ai
# WEAVE_TRACE_URL=https://trace.wandb.ai
# WANDB_APP_URL=https://wandb.ai

# Set to 1 when running behind a reverse proxy (Render, Fly, Caddy, nginx) so
# login throttling sees real client addresses.
# TRUST_PROXY=1

# Set these as environment variables on hosts with no persistent disk, so sessions
# survive restarts. Any long random string works for SESSION_SECRET.
# SESSION_SECRET=
# SESSION_DAYS=30
